# Names only. Never commit real values.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/college
SESSION_SECRET=replace-with-32+-random-chars
# local = email + password stored as scrypt hashes (students start with their roll number); supabase = Supabase Auth
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
# anthropic | fixture (mock, non-production only) | none (AI disabled, manual forms remain)
AI_PROVIDER=none
ANTHROPIC_API_KEY=
RUNTIME_MODEL=
WORKER_CONCURRENCY=2
# Public origin used for CSRF origin checks, e.g. https://college-solver.onrender.com
APP_ORIGIN=http://localhost:3000
