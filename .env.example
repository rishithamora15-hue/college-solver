# Names only. Never commit real values.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/college
# Hosted Postgres (Supabase): use the Session pooler connection string, and point this at the CA certificate
# downloaded from Supabase > Database settings > SSL configuration (a file path, or the PEM text itself).
DATABASE_CA_CERT=
SESSION_SECRET=replace-with-32+-random-chars
# local = email + password stored as scrypt hashes (students start with their roll number)
# supabase = every sign-in lives in Supabase Auth (Authentication > Users); the app creates them with exactly the email and
# password entered. Keys: Supabase > Project Settings > API Keys. The secret key stays on the server only.
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# gemini | anthropic | fixture (mock, non-production only) | none (AI disabled, manual forms remain)
AI_PROVIDER=none
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Model id for the chosen provider, e.g. gemini-3.8-flash
RUNTIME_MODEL=
WORKER_CONCURRENCY=2
# Public origin used for CSRF origin checks, e.g. https://college-solver.onrender.com
APP_ORIGIN=http://localhost:3000
